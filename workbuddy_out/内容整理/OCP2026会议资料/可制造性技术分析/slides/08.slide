<Slide style={{ width: 1280, height: 720, background: '#0E1420', position: 'relative', overflow: 'hidden' }}>

    <Box style={{ position: 'absolute', left: 72, top: 40, width: 3, height: 44, background: '#C8A15A' }} />
    <Box style={{ position: 'absolute', left: 92, top: 36, width: 900 }}><Text style={{ fontSize: 36, fontWeight: 'bold', lineHeight: 1.3, color: '#E8EDF3' }}>覆盖率不是百分比，是四个分母</Text></Box>
    <Box style={{ position: 'absolute', right: 72, top: 46 }}><Text style={{ fontFamily: 'Georgia', fontSize: 14, letterSpacing: 2, color: 'rgba(232,237,243,0.45)' }}>02 · 三级验收</Text></Box>

    <Box style={{ position: 'absolute', left: 72, top: 140, width: 316, height: 452, flexDirection: 'column' }}>
        <Text style={{ fontSize: 13, letterSpacing: 3, color: '#C8A15A' }}>为什么必须分层</Text>
        <Text style={{ fontSize: 32, fontWeight: 'bold', lineHeight: 1.35, color: '#E8EDF3', marginTop: 12 }}>一个 85%，<br />至少有两种读法。</Text>
        <Box style={{ width: 48, height: 2, background: 'rgba(200,161,90,0.55)', marginTop: 20, marginBottom: 20 }} />
        <Text style={{ fontSize: 14.5, lineHeight: 1.85, color: 'rgba(232,237,243,0.55)' }}>可以是「85% 的用例都通过」，也可以是「85% 的条目有对应用例」。两个 85% 的工程含义完全不同。</Text>
        <Box style={{ width: 40, height: 1, background: 'rgba(232,237,243,0.14)', marginTop: 'auto', marginBottom: 16 }} />
        <Text style={{ fontSize: 15, lineHeight: 1.75, color: '#C8A15A' }}>所以评审材料里应当出现四个数字，而不是一个。</Text>
    </Box>

    <Box style={{ position: 'absolute', left: 440, top: 176, width: 151, height: 8, background: 'rgba(232,237,243,0.24)' }} />
<Box style={{ position: 'absolute', left: 594, top: 176, width: 189, height: 8, background: 'rgba(232,237,243,0.42)' }} />
<Box style={{ position: 'absolute', left: 786, top: 176, width: 189, height: 8, background: 'rgba(200,161,90,0.55)' }} />
<Box style={{ position: 'absolute', left: 978, top: 176, width: 227, height: 8, background: '#C8A15A' }} />

    <Box style={{ position: 'absolute', left: 440, top: 150, width: 768, flexDirection: 'row', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 11, letterSpacing: 2, color: 'rgba(232,237,243,0.35)' }}>四层权重分配</Text>
        <Text style={{ fontSize: 11, letterSpacing: 1, color: 'rgba(232,237,243,0.35)' }}>故障模式层权重最高，因为它最难伪造</Text>
    </Box>

    <Box style={{ position: 'absolute', left: 440, top: 214, width: 78 }}><Text style={{ fontFamily: 'Georgia', fontSize: 30, lineHeight: 1.2, color: '#C8A15A' }}>20%</Text></Box>
<Box style={{ position: 'absolute', left: 528, top: 218, width: 680, flexDirection: 'row', alignItems: 'baseline', gap: 12 }}>
        <Text style={{ fontSize: 18, fontWeight: 'bold', lineHeight: 1.4, color: '#E8EDF3' }}>需求覆盖</Text>
        <Text style={{ fontSize: 13.5, lineHeight: 1.5, color: 'rgba(232,237,243,0.45)' }}>分母：规格书里的验收条目数</Text>
    </Box>
<Box style={{ position: 'absolute', left: 528, top: 252, width: 680, flexDirection: 'row', alignItems: 'flex-start', gap: 8 }}>
        <Box style={{ background: 'rgba(200,161,90,0.16)', padding: 4, marginTop: 1 }}><Text style={{ fontSize: 11, lineHeight: 1.2, color: '#C8A15A' }}>陷阱</Text></Box>
        <Text style={{ fontSize: 13.5, lineHeight: 1.6, color: 'rgba(232,237,243,0.52)', width: 620 }}>只统计「有对应用例」的条目，不统计用例能否真的判定通过 / 失败。</Text>
    </Box>
<Box style={{ position: 'absolute', left: 440, top: 294, width: 768, height: 1, background: 'rgba(232,237,243,0.07)' }} />
<Box style={{ position: 'absolute', left: 440, top: 302, width: 78 }}><Text style={{ fontFamily: 'Georgia', fontSize: 30, lineHeight: 1.2, color: '#C8A15A' }}>25%</Text></Box>
<Box style={{ position: 'absolute', left: 528, top: 306, width: 680, flexDirection: 'row', alignItems: 'baseline', gap: 12 }}>
        <Text style={{ fontSize: 18, fontWeight: 'bold', lineHeight: 1.4, color: '#E8EDF3' }}>拓扑覆盖</Text>
        <Text style={{ fontSize: 13.5, lineHeight: 1.5, color: 'rgba(232,237,243,0.45)' }}>分母：拓扑上所有需被信号或液体经过的节点与链路</Text>
    </Box>
<Box style={{ position: 'absolute', left: 528, top: 340, width: 680, flexDirection: 'row', alignItems: 'flex-start', gap: 8 }}>
        <Box style={{ background: 'rgba(200,161,90,0.16)', padding: 4, marginTop: 1 }}><Text style={{ fontSize: 11, lineHeight: 1.2, color: '#C8A15A' }}>陷阱</Text></Box>
        <Text style={{ fontSize: 13.5, lineHeight: 1.6, color: 'rgba(232,237,243,0.52)', width: 620 }}>只测典型路径，把边角端口、备用链路默认算作已覆盖。</Text>
    </Box>
<Box style={{ position: 'absolute', left: 440, top: 382, width: 768, height: 1, background: 'rgba(232,237,243,0.07)' }} />
<Box style={{ position: 'absolute', left: 440, top: 390, width: 78 }}><Text style={{ fontFamily: 'Georgia', fontSize: 30, lineHeight: 1.2, color: '#C8A15A' }}>25%</Text></Box>
<Box style={{ position: 'absolute', left: 528, top: 394, width: 680, flexDirection: 'row', alignItems: 'baseline', gap: 12 }}>
        <Text style={{ fontSize: 18, fontWeight: 'bold', lineHeight: 1.4, color: '#E8EDF3' }}>工况覆盖</Text>
        <Text style={{ fontSize: 13.5, lineHeight: 1.5, color: 'rgba(232,237,243,0.45)' }}>分母：温度 / 负载 / 电压 / 流量构成的工况组合</Text>
    </Box>
<Box style={{ position: 'absolute', left: 528, top: 428, width: 680, flexDirection: 'row', alignItems: 'flex-start', gap: 8 }}>
        <Box style={{ background: 'rgba(200,161,90,0.16)', padding: 4, marginTop: 1 }}><Text style={{ fontSize: 11, lineHeight: 1.2, color: '#C8A15A' }}>陷阱</Text></Box>
        <Text style={{ fontSize: 13.5, lineHeight: 1.6, color: 'rgba(232,237,243,0.52)', width: 620 }}>只在稳态额定工况下测，用单点结论代表全域。</Text>
    </Box>
<Box style={{ position: 'absolute', left: 440, top: 470, width: 768, height: 1, background: 'rgba(232,237,243,0.07)' }} />
<Box style={{ position: 'absolute', left: 440, top: 478, width: 78 }}><Text style={{ fontFamily: 'Georgia', fontSize: 30, lineHeight: 1.2, color: '#C8A15A' }}>30%</Text></Box>
<Box style={{ position: 'absolute', left: 528, top: 482, width: 680, flexDirection: 'row', alignItems: 'baseline', gap: 12 }}>
        <Text style={{ fontSize: 18, fontWeight: 'bold', lineHeight: 1.4, color: '#E8EDF3' }}>故障模式覆盖</Text>
        <Text style={{ fontSize: 13.5, lineHeight: 1.5, color: 'rgba(232,237,243,0.45)' }}>分母：FMEA 中已被识别出的失效模式数</Text>
    </Box>
<Box style={{ position: 'absolute', left: 528, top: 516, width: 680, flexDirection: 'row', alignItems: 'flex-start', gap: 8 }}>
        <Box style={{ background: 'rgba(200,161,90,0.16)', padding: 4, marginTop: 1 }}><Text style={{ fontSize: 11, lineHeight: 1.2, color: '#C8A15A' }}>陷阱</Text></Box>
        <Text style={{ fontSize: 13.5, lineHeight: 1.6, color: 'rgba(232,237,243,0.52)', width: 620 }}>分母只写「已知会坏的」，未识别的失效模式根本不进分母。</Text>
    </Box>

    <Box style={{ position: 'absolute', left: 440, top: 582, width: 768, height: 66, background: '#1B2432', flexDirection: 'column', justifyContent: 'center', padding: 16 }}>
        <Text style={{ fontFamily: 'Georgia', fontSize: 13, letterSpacing: 1, lineHeight: 1.5, color: '#C8A15A' }}>WCI = 0.20·需求 + 0.25·拓扑 + 0.25·工况 + 0.30·故障模式</Text>
        <Text style={{ fontSize: 12, lineHeight: 1.5, color: 'rgba(232,237,243,0.45)', marginTop: 4 }}>红线：任一层低于 50 分，直接判不通过——不允许用加权平均掩盖结构性缺失。</Text>
    </Box>

    <Box style={{ position: 'absolute', left: 72, top: 660, width: 1136, height: 1, background: 'rgba(232,237,243,0.10)' }} />
    <Box style={{ position: 'absolute', left: 72, top: 678 }}><Text style={{ fontSize: 14, color: 'rgba(232,237,243,0.35)' }}>可制造性评估维度解析</Text></Box>
    <Box style={{ position: 'absolute', right: 72, top: 678 }}><Text style={{ fontFamily: 'Georgia', fontSize: 14, color: 'rgba(232,237,243,0.45)' }}>08 / 16</Text></Box>

</Slide>
