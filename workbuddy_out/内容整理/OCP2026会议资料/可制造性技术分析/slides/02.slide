            <Text style={{ fontFamily: 'Georgia', fontSize: 32, lineHeight: 1.2, color: '#C8A15A', width: 62 }}>01</Text>
            <Box style={{ flexDirection: 'column', gap: 9, width: 726 }}>
                <Box style={{ flexDirection: 'row', alignItems: 'flex-end', justifyContent: 'space-between', width: 726 }}>
                    <Text style={{ fontSize: 25, fontWeight: 'bold', lineHeight: 1.3, color: '#E8EDF3' }}>起点：一行十九个字</Text>
                    <Text style={{ fontFamily: 'Georgia', fontSize: 14, lineHeight: 1.3, color: 'rgba(232,237,243,0.40)' }}>P3–P4</Text>
                </Box>
                <Text style={{ fontSize: 15, lineHeight: 1.6, color: 'rgba(232,237,243,0.50)' }}>为什么这一行值得单独拆——它把「做出来了」和「能重复做出来」切成两件事。</Text>
            </Box>
        </Box>
        <Box style={{ width: 788, height: 1, background: 'rgba(232,237,243,0.10)' }} />

        <Box style={{ flexDirection: 'row', alignItems: 'flex-start', height: 104 }}>
            <Text style={{ fontFamily: 'Georgia', fontSize: 32, lineHeight: 1.2, color: '#C8A15A', width: 62 }}>02</Text>
            <Box style={{ flexDirection: 'column', gap: 9, width: 726 }}>
                <Box style={{ flexDirection: 'row', alignItems: 'flex-end', justifyContent: 'space-between', width: 726 }}>
                    <Text style={{ fontSize: 25, fontWeight: 'bold', lineHeight: 1.3, color: '#E8EDF3' }}>三级验收与覆盖率</Text>
                    <Text style={{ fontFamily: 'Georgia', fontSize: 14, lineHeight: 1.3, color: 'rgba(232,237,243,0.40)' }}>P5–P9</Text>
                </Box>
                <Text style={{ fontSize: 15, lineHeight: 1.6, color: 'rgba(232,237,243,0.50)' }}>L10 / L11 / L12 各自证明什么、不证明什么；覆盖率如何不被一个百分比糊弄。</Text>
            </Box>
        </Box>
        <Box style={{ width: 788, height: 1, background: 'rgba(232,237,243,0.10)' }} />

        <Box style={{ flexDirection: 'row', alignItems: 'flex-start', height: 104 }}>
            <Text style={{ fontFamily: 'Georgia', fontSize: 32, lineHeight: 1.2, color: '#C8A15A', width: 62 }}>03</Text>
            <Box style={{ flexDirection: 'column', gap: 9, width: 726 }}>
                <Box style={{ flexDirection: 'row', alignItems: 'flex-end', justifyContent: 'space-between', width: 726 }}>
