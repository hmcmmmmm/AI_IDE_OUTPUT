# ============================================================
# 上传范围：仅 workbuddy_out/内容整理 与 workbuddy_out/md_output
# 其余目录（yt_* 原始产出、_work 工作区、制作管线调研等）不纳入版本控制
# ============================================================
/workbuddy_out/*
!/workbuddy_out/内容整理/
!/workbuddy_out/md_output/

# 内容整理 内的临时工作区与在制目录
_work/
/workbuddy_out/内容整理/yt_*/

# 本地 AI Agent 运行数据，不纳入版本控制
.workbuddy-ai/

# 系统与临时文件
.DS_Store
Thumbs.db
desktop.ini
*.tmp

# 视频文件：体积过大，不上传（GitHub 单文件上限 100MB，仓库建议 1GB 以内）
*.mkv
*.mp4
*.avi
*.mov
*.wmv
*.flv
*.webm
*.m4v
*.mpg
*.mpeg
*.rmvb
*.rm
*.vob
*.m2ts
*.mts
*.3gp
*.ogv
*.ts

# Office / WPS 打开文档时产生的锁文件
~$*
.~lock.*

# 网盘 / 下载工具的未完成临时文件
*.downloading
*.baiduyun.p.downloading
*.part
*.crdownload
*.!qb
